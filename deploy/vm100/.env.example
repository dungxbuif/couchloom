POSTGRES_PASSWORD=<generate-a-strong-password>
MCP_AUTH_TOKEN=<generate-a-strong-password>
COUCHLOOM_RUN_DIR=/opt/apps/couchloom/run
COUCHLOOM_IMAGE_TAG=vm100

EMBEDDING_MODEL=nomic-embed-text
EMBEDDING_DIMENSIONS=768
RAG_CHUNK_CHARS=1800
RAG_CHUNK_OVERLAP=200
RAG_RETRY_LIMIT=10
RAG_RETRY_DELAY_SECONDS=1
RAG_RETRY_DELAY_MAX_SECONDS=900
RAG_JOB_HEARTBEAT_SECONDS=30
RAG_RECONCILE_INTERVAL_MS=300000
RAG_WORKER_CONCURRENCY=1
RAG_SHUTDOWN_GRACE_MS=30000
