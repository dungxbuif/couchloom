{
    "compilerOptions": {
        "target": "ES2022",
        "module": "ES2022",
        "moduleResolution": "bundler",
        "esModuleInterop": true,
        "strict": true,
        "skipLibCheck": true,
        "resolveJsonModule": true,
        "allowImportingTsExtensions": true,
        "outDir": "dist",
        "rootDir": ".",
        "paths": {
            "@lib/*": ["./lib/livesync-commonlib/src/*"],
            "@/*": ["./src/stubs/*"]
        }
    },
    "include": ["src/**/*"]
}
