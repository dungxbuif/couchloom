POSTGRES_PASSWORD=<generate-a-strong-password>
MCP_AUTH_TOKEN=<generate-a-strong-password>
BASE_URL=http://vm100:8787

# Compact JSON. Add one object per CouchDB database.
VAULTS_CONFIG=[{"id":"personal","name":"Personal","mode":"couchdb","url":"http://couchdb:5984","database":"vault_personal","user":"admin","password":"<couchdb-password>","passphrase":"<optional-e2e-passphrase>","obfuscatePaths":false}]

# OpenAI-compatible embeddings endpoint (OpenAI, Ollama proxy, LiteLLM, etc.)
EMBEDDING_BASE_URL=http://embedding-service:11434/v1
EMBEDDING_API_KEY=
EMBEDDING_MODEL=nomic-embed-text
EMBEDDING_DIMENSIONS=768

# Optional
COUCHLOOM_PORT=8787
RAG_CHUNK_CHARS=1800
RAG_CHUNK_OVERLAP=200
