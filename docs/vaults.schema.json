{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/dungxbuif/couchloom/blob/main/docs/vaults.schema.json",
  "title": "CouchLoom vault configuration",
  "type": "array",
  "minItems": 1,
  "items": {
    "oneOf": [
      { "$ref": "#/$defs/localVault" },
      { "$ref": "#/$defs/couchDbVault" }
    ]
  },
  "$defs": {
    "base": {
      "type": "object",
      "required": ["id", "name", "mode"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$" },
        "name": { "type": "string", "minLength": 1 },
        "mode": { "enum": ["local", "couchdb"] }
      }
    },
    "localVault": {
      "unevaluatedProperties": false,
      "allOf": [
        { "$ref": "#/$defs/base" },
        {
          "type": "object",
          "required": ["path"],
          "properties": { "mode": { "const": "local" }, "path": { "type": "string", "minLength": 1 } }
        }
      ]
    },
    "couchDbVault": {
      "unevaluatedProperties": false,
      "allOf": [
        { "$ref": "#/$defs/base" },
        {
          "type": "object",
          "required": ["url", "database", "user", "password"],
          "properties": {
            "mode": { "const": "couchdb" },
            "url": { "type": "string", "format": "uri" },
            "database": { "type": "string", "minLength": 1 },
            "user": { "type": "string", "minLength": 1 },
            "password": { "type": "string", "minLength": 1 },
            "passphrase": { "type": "string" },
            "obfuscatePaths": { "type": "boolean", "default": false }
          }
        }
      ]
    }
  }
}
