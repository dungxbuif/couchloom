{
    "name": "couchloom",
    "version": "0.1.0",
    "description": "Multi-vault CouchDB knowledge service for AI agents",
    "private": true,
    "packageManager": "bun@1.3.14",
    "workspaces": ["packages/*", "apps/*"],
    "type": "module",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/dungxbuif/couchloom.git"
    },
    "keywords": [
        "mcp",
        "obsidian",
        "livesync",
        "couchdb",
        "openclaw",
        "ai"
    ],
    "scripts": {
        "build": "bun run --cwd packages/core build && bun run --cwd packages/rag build && bun run --cwd apps/server build",
        "dev": "bun run --cwd apps/server dev",
        "start": "bun run --cwd apps/server start",
        "test": "bun run --cwd packages/core test && bun run --cwd packages/rag test && bun run --cwd apps/server test",
        "test:e2e": "bun test apps/server/test/e2e/mcp.e2e.test.ts apps/server/test/e2e/multi-vault.e2e.test.ts apps/server/test/e2e/rag-recovery.e2e.test.ts",
        "test:couchdb": "bun test apps/server/test/e2e/couchdb-obfuscation.e2e.test.ts",
        "test:pgvector": "bun test packages/rag/test/integration/pgvector.integration.test.ts"
    },
    "devDependencies": {
        "@types/node": "^22",
        "tsup": "^8",
        "typescript": "^5"
    }
}
